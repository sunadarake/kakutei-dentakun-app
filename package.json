{
  "name": "kakutei-dentakun",
  "version": "1.0.1",
  "main": "src/main/index.js",
  "scripts": {
    "dev:win": "set NODE_ENV=development && electron . --no-sandbox",
    "dev:linux": "NODE_ENV=development electron . --no-sandbox",
    "build:win": "set NODE_ENV=production && electron-builder --win",
    "build:linux": "electron-builder --linux",
    "icon": "sh scripts/make-icon.sh",
    "release": "sh scripts/release.sh",
    "publish": "sh scripts/publish.sh"
  },
  "keywords": [],
  "author": {
    "name": "sunadarake",
    "email": "your@email.com"
  },
  "license": "MIT",
  "description": "",
  "build": {
    "appId": "com.kakutei.dentakun",
    "productName": "確定申告足し算くん",
    "icon": "icons/icon.png",
    "compression": "maximum",
    "electronLanguages": [
      "ja",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "icons/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "icons/icon.png",
      "category": "Office"
    }
  },
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1"
  }
}
